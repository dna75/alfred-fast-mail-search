				<string>if [ "$action" = "copy" ]; then
  printf %s "$1" | pbcopy
  exit 0
fi
case "$1" in
  install-python)
    /usr/bin/xcode-select --install ;;
  emlx:*)
    # Older Mail databases: locate the message file by its id and let Mail open it
    id="${1#emlx:}"
    f=$(find "$HOME/Library/Mail" -type f \( -name "$id.emlx" -o -name "$id.partial.emlx" \) -print -quit 2&gt;/dev/null)
    if [ -n "$f" ]; then open "$f"; else open -a Mail; fi ;;
  *)
    open "$1" ;;
esac</string>
